# --- Eneo ---
# Bas-URL till er Eneo-instans (utan avslutande snedstreck).
ENEO_API_BASE=https://flow.example.com
ENEO_API_KEY=sk_replace_me

# --- App auth ---
# Användare måste ange denna kod på login-sidan för att kunna använda appen.
# Minst 4 tecken. Välj något långt och oförutsägbart för publika deploys.
APP_ACCESS_CODE=replace-with-demo-code

# Signerar session-cookien. Generera ny:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minst 32 tecken.
SESSION_SECRET=replace-with-long-random-string

# Sätt till true bakom HTTPS (produktion). Sätt false för lokal http://localhost.
COOKIE_SECURE=true

# Max tid, i sekunder, som backend får vänta när den skickar en uppladdad fil vidare till Eneo.
# Behövs för stora ljudfiler och långsamt nät. Browsern använder egen progressbaserad timeout.
UPLOAD_PROXY_TIMEOUT_SECONDS=1800

# --- Hardcoded space (valfritt) ---
# Om satt: skippar space-väljaren i UI och listar bara flöden i detta space.
DEMO_SPACE_ID=
DEMO_SPACE_NAME=

# --- Andra spacet (valfritt) ---
# För att visa flöden från ytterligare ett space krävs en SEPARAT API-nyckel
# (vår backend väljer nyckel utifrån X-Space-Id-headern frontend skickar).
# Båda måste sättas för att den extra sektionen ska aktiveras.
ENEO_API_KEY_2=
DEMO_SPACE_ID_2=
DEMO_SPACE_NAME_2=
